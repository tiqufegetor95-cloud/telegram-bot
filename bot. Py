def detect_user_location(user_from):
    lang_code = user_from.get("language_code", "bn")
    if lang_code.startswith("hi"): return "India", "🇮🇳", "hi"
    elif lang_code.startswith("zh"): return "China", "🇨🇳", "zh"
    elif lang_code.startswith("en") and not lang_code.startswith("bn"): return "United States", "🇺🇸", "en"
    else: return "Bangladesh", "🇧🇩", "bn"

def get_user(user_id, user_from=None):
    global today_date
    if datetime.date.today() != today_date:
        today_date = datetime.date.today()
    if user_id not in users_db:
        country, flag, lang = detect_user_location(user_from or {})
        users_db[user_id] = {
            "lang": lang, "country": country, "flag": flag,
            "balance": 0.0, "referrals": 0, "captchas": 0,
            "status": "Free Member ⚪", "current_task": None,
            "correct_ans": None, "joined_date": datetime.date.today()
        }
    return users_db[user_id]

def send_telegram(token, method, payload):
    url = f"https://api.telegram.org/bot{token}/{method}"
    data = json.dumps(payload).encode('utf-8')
    req = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            return json.loads(response.read().decode('utf-8'))
    except Exception as e:
        return {"ok": False}

def edit_message_text(token, chat_id, message_id, text, reply_markup=None):
    payload = {"chat_id": chat_id, "message_id": message_id, "text": text, "parse_mode": "Markdown"}
    if reply_markup: payload["reply_markup"] = reply_markup
    send_telegram(token, "editMessageText", payload)

def answer_callback(token, callback_query_id, text="", show_alert=False):
